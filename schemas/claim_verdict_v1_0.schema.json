{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenteval.local/schemas/claim_verdict_v1_0.schema.json",
  "title": "AgentEval Claim Verdict 1.0",
  "type": "object",
  "required": ["schema_version", "claim_id", "run_id", "task_id", "verdict", "confidence", "reason", "evidence_refs", "evidence_considered", "unsupported_parts", "judge_path", "risk_level", "severity", "severity_reason", "requires_review"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "claim_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "verdict": {"enum": ["supported", "partially_supported", "unsupported", "contradicted", "not_enough_evidence"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "reason": {"type": "string", "minLength": 1},
    "evidence_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "evidence_considered": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "unsupported_parts": {"type": "array", "items": {"type": "string"}},
    "judge_path": {"enum": ["deterministic", "semantic", "deterministic_precedence", "unresolved"]},
    "risk_level": {"enum": ["low", "medium", "high"]},
    "severity": {"enum": ["none", "low", "medium", "high"]},
    "severity_reason": {"type": "string", "minLength": 1},
    "requires_review": {"type": "boolean"}
  },
  "additionalProperties": true
}
