{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenteval.local/schemas/judge_call_v1_0.schema.json",
  "title": "AgentEval Semantic Judge Call 1.0",
  "type": "object",
  "required": ["schema_version", "judge_call_id", "claim_id", "provider", "model", "prompt_version", "temperature", "cache_key", "cache_hit", "latency_ms", "input_tokens", "output_tokens", "estimated_cost", "redacted", "status", "error"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "judge_call_id": {"type": "string", "minLength": 1},
    "claim_id": {"type": "string", "minLength": 1},
    "provider": {"type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1},
    "prompt_version": {"type": "string", "minLength": 1},
    "temperature": {"const": 0},
    "cache_key": {"type": "string", "minLength": 1},
    "cache_hit": {"type": "boolean"},
    "latency_ms": {"type": "integer", "minimum": 0},
    "input_tokens": {"type": "integer", "minimum": 0},
    "output_tokens": {"type": "integer", "minimum": 0},
    "estimated_cost": {"type": "number", "minimum": 0},
    "redacted": {"type": "boolean"},
    "attempts": {"type": "integer", "minimum": 0},
    "status": {"enum": ["success", "invalid_output", "timeout", "budget_exhausted", "error"]},
    "error": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
